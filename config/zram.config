# ZRAM 压缩算法配置片段
# 由 build.yml 工作流在启用 use_zram 时追加到 defconfig
# CRYPTO_* 为 5.10~6.6 的 crypto 接口 zram 所需；
# ZRAM_BACKEND_* 为 6.12 新架构 zram（backend_* 直连实现）所需，
# 仅 6.12+ 的 Kconfig 声明了这些符号；6.12 以下由 build.yml 剔除
# （bazel kernel_config 校验要求 fragment 配置项必须存在于 Kconfig）
CONFIG_CRYPTO_LZ4HC=y
CONFIG_CRYPTO_LZ4K=y
CONFIG_CRYPTO_LZ4KD=y
CONFIG_CRYPTO_842=y
CONFIG_CRYPTO_LZ4K_OPLUS=y
CONFIG_ZRAM_BACKEND_LZ4K=y
CONFIG_ZRAM_BACKEND_LZ4KD=y
CONFIG_ZRAM_BACKEND_LZ4K_OPLUS=y

# 冷页写回：允许把 zram 中长期不用的页写回 backing_dev，降低 zram 占用。
# 仅打开内核能力；真正生效需运行时执行 `echo /dev/block/xxx > /sys/block/zram0/backing_dev`
# （由 houji-bore-tweaks 模块或手动下发）。6.12 以下经 build.yml 剔除 BACKEND_* 后仍保留本行。
# 该符号在 5.10~6.6 的 Kconfig 中均存在，bazel kernel_config 校验可通过。
CONFIG_ZRAM_WRITEBACK=y
